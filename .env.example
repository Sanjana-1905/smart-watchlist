# Postgres
POSTGRES_USER=watchlist
POSTGRES_PASSWORD=watchlist_dev_pw
POSTGRES_DB=watchlist
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used INSIDE docker compose network (service name "db")
DATABASE_URL=postgresql+psycopg2://watchlist:watchlist_dev_pw@db:5432/watchlist

# Redis
REDIS_URL=redis://redis:6379/0

# Market provider: mock | yfinance
MARKET_PROVIDER=mock

# App
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Auth — development/demo defaults only. Replace in production.
JWT_SECRET=smart-watchlist-dev-only-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
DEMO_MODE=true
